# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ir para o Git (já está no .gitignore).
#
# Como descobrir os IDs: com o bot rodando, envie !idgrupo dentro do grupo
# desejado a partir de um número que esteja em NUMEROS_VERIFICACAO.
# Formatos: pessoa = 5521999999999 (ou 5521999999999@s.whatsapp.net,
#                     5521999999999@c.us do bot antigo, 000000000000000@lid)
#           grupo  = 120363000000000000@g.us

# --- Destinos (obrigatórios) ------------------------------------------------

# Grupo(s) onde os pedidos de oração APROVADOS são publicados (o grupo REAL).
GRUPOS_ORACAO=

# Grupo(s) de TESTE, usados SÓ no modo teste (MODO_TESTE=true). Com o modo teste
# ligado, todo envio a grupos (pedidos aprovados e avisos à equipe) vai para cá e
# nunca para GRUPOS_ORACAO nem GRUPOS_NOTIFICACAO_HUMANO; com MODO_TESTE=false,
# voltam sozinhos para eles. Obrigatório no modo teste.
GRUPOS_ORACAO_TESTE=

# Números que recebem os pedidos para aprovar e podem usar !pedidos / !aprovar.
# Separe por vírgula.
NUMEROS_VERIFICACAO=

# Grupo(s) avisados quando alguém pede atendimento humano, certidão ou envia
# nomes do Mês das Almas (a secretaria). Se ficar vazio, o aviso vai para
# NUMEROS_VERIFICACAO. No modo teste este valor é ignorado (vale o grupo de teste).
GRUPOS_NOTIFICACAO_HUMANO=

# Números que o bot deve ignorar completamente. Separe por vírgula.
BLACKLIST=

# --- WhatsApp (Baileys) ----------------------------------------------------

# Número do aparelho onde o bot roda, só dígitos, com DDI e DDD.
# ATENÇÃO: tem que ser exatamente o número com que o WhatsApp foi registrado.
# Números antigos às vezes estão registrados SEM o 9 inicial
# (ex.: 552188887777 em vez de 5521988887777). Se o código de pareamento não
# for aceito no celular, tente a outra forma.
# Só é usado para parear; depois disso a sessão fica na pasta auth/.
NUMERO_BOT=

# Nível de log interno do Baileys: fatal, error, warn (padrão), info, debug.
# Acima de warn o log passa a conter detalhes das mensagens: não use em produção.
LOG_BAILEYS=warn

# --- Anti-banimento -----------------------------------------------------------

# Milissegundos mostrando "digitando..." antes de cada resposta.
ATRASO_RESPOSTA_MS=1200
# Máximo de mensagens enviadas por minuto, somando todas as conversas.
LIMITE_ENVIOS_MINUTO=30

# --- Modo teste -------------------------------------------------------------

# Com "true", o bot fica calado para todo mundo, menos para o NUMERO_TESTE
# (opcional) e para quem enviar "/teste" no privado ("/teste sair" desfaz).
# Ótimo para validar mudanças sem incomodar os fiéis, e para rodar o bot num
# número pessoal: mensagens e ligações de quem não está testando são ignoradas.
MODO_TESTE=false
NUMERO_TESTE=
# Horas que a inscrição de quem enviou "/teste" continua valendo.
TESTE_VALIDADE_HORAS=24

# --- Tempos (opcionais, valores padrão indicados) ---------------------------

# Minutos de silêncio até perguntar "Podemos ajudar com algo mais?"
TEMPO_AVISO_MIN=5
# Minutos após o aviso até encerrar o atendimento.
TEMPO_ENCERRAMENTO_MIN=5
# Segundos de espera entre respostas do menu para o mesmo contato.
COOLDOWN_SEGUNDOS=5
# Segundos mínimos entre dois pedidos de oração do mesmo contato.
INTERVALO_PEDIDO_SEGUNDOS=30
# Dias que um pedido não aprovado fica na fila antes de ser descartado.
VALIDADE_PEDIDO_DIAS=7
# Minutos até soltar quem entrou em "pedido de oração" e sumiu.
EXPIRA_ORACAO_MIN=30
# Horas até soltar quem pediu atendimento humano e nunca foi liberado com !auto.
EXPIRA_HUMANO_HORAS=6

